{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleRecorder",
  "version": "1.0.0",
  "identifier": "com.simplerecorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monora",
        "width": 920,
        "height": 540,
        "minWidth": 880,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: https://asset.localhost http://asset.localhost blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/**", "$HOME/Videos/**", "**/SimpleRecorder/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
